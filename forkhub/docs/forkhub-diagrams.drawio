        <mxCell id="cLs" value="&lt;b&gt;Browser storage — localStorage&lt;/b&gt; &lt;span style='font-size:9px'&gt;(per client)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;auth_token · auth_user&lt;br&gt;fh_cart_items · fh_last_order&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;Cart lives here until checkout →&lt;/span&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#000000;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;html=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="92" width="440" height="140" as="geometry"/></mxCell>

